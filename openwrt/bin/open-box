#!/bin/sh
# Open-Box 命令行:SSH 登上路由器后敲 open-box。忘了面板密码、想看看有没有新版本时用。
#
#   open-box              交互菜单:1 当前密码 / 2 重新启动 / 3 检查升级 / 4 卸载 / 5 退出
#   open-box password     只打印面板密码(LuCI 的 Open-Box 页面也调这一条)。退出码:0 有 / 3 还没设置 / 1 读不了
#   open-box restart      重启内核和面板:内核和面板里点「重启」一样重新生成配置再启动,面板重启服务
#   open-box start        生成配置并启动内核(和面板里点「启动」同一条流程;--detach 后台跑、--status 看结果,LuCI 页面用)
#   open-box check        只检查有没有新版本,不升级。输出三行:current=… latest=… status=latest|update|unknown
#   open-box update       直接升级(等同于 sh /opt/open-box/update.sh,沿用安装时选的下载通道)
#   open-box uninstall    卸载(等同于 sh /opt/open-box/uninstall.sh;默认保留 data/,脚本会当场问)
#   open-box port         打印面板当前端口
#   open-box port <端口>   改面板端口:先查冲突,过了才写;面板在跑就自动重启(LuCI 页面的「修改端口」调的就是它)
#
# 装在 /opt/open-box/openwrt/bin/open-box,/usr/bin/open-box 是指向它的软链接:安装 / 升级脚本会建,面板服务每次
# 启动也补一次(openwrt/initd/openbox-panel)——老版本的升级脚本不认识这个文件,靠后者兜住。
# Debian / Ubuntu 上同一份脚本,软链接在 /usr/local/bin/open-box(debian/bin/openbox-panel-run 补),服务脚本换成
# debian/bin/openbox-ctl / openbox-panel-ctl(见 svc_script),其余一样。
# POSIX sh(OpenWrt 是 busybox ash,Debian 是 dash),不用 bashism。

ROOT=/opt/open-box
NODE="$ROOT/node/bin/node"
DB="$ROOT/data/openbox.sqlite"
META="$ROOT/meta.json"
REPO="timeflysoon/Open-Box"
# 与 scripts/update.sh 的 BUILTIN_MIRRORS 保持一致
MIRRORS="https://ghfast.top https://gh-proxy.com https://gh.llkk.cc"

# ---- openbox-port-check:start ----
# 这一段在 scripts/install.sh 里有一份**一模一样**的拷贝(安装脚本是单独 curl 下来先跑的,
# 那时候包还没解开,没法共用文件)。两边必须逐字相同,由 panel/server/system/port-check-parity.test.mjs 守着。
# 面板端口存在 data/panel-port(跟着 data 走:升级不动、卸载保留数据时也留着)。
# 没有这个文件就是 2026 —— v0.1.216 及更早装的机器都没有它,默认值一变它们升级后就打不开了。
OPENBOX_PORT_FILE=/opt/open-box/data/panel-port
OPENBOX_PORT_FALLBACK=2026
OPENBOX_PORT_DEFAULT=3036
# Open-Box 自己占的端口(内核 clash API / DNS 入站 / DNS 重写 / 回环入站)和动不得的系统端口
OPENBOX_RESERVED_PORTS="9095 7853 7854 7891 53 22 80 443"

# 端口能不能用:不能用时把原因打到 stdout 并返回 0;能用返回 1
openbox_port_problem() {
  _p="$1"
  case "$_p" in
    ''|*[!0-9]*) echo "端口要填 1024-65535 的数字"; return 0 ;;
  esac
  if [ "$_p" -lt 1024 ] || [ "$_p" -gt 65535 ]; then
    echo "端口要在 1024-65535 之间(1024 以下是系统保留端口)"
    return 0
  fi
  for _r in $OPENBOX_RESERVED_PORTS; do
    if [ "$_p" = "$_r" ]; then
      echo "$_p 是 Open-Box 自己或系统服务在用的端口(内核 API / DNS / SSH / HTTP 等),换一个"
      return 0
    fi
  done
  # 真在监听的端口。ss 优先(OpenWrt 新固件自带),没有就退回 netstat;两个都没有就只能跳过这一项检查
  _busy=""
  if command -v ss >/dev/null 2>&1; then
    _busy=$(ss -ltn 2>/dev/null | awk 'NR>1 {print $4}' | sed 's/.*[:.]//' | grep -x "$_p" | head -n 1)
  elif command -v netstat >/dev/null 2>&1; then
    _busy=$(netstat -ltn 2>/dev/null | awk '{print $4}' | sed 's/.*[:.]//' | grep -x "$_p" | head -n 1)
  fi
  if [ -n "$_busy" ]; then
    echo "$_p 已经被别的程序占用(已在监听)"
    return 0
  fi
  return 1
}

openbox_current_port() {
  _cp=$(cat "$OPENBOX_PORT_FILE" 2>/dev/null | tr -dc '0-9')
  [ -n "$_cp" ] || _cp="$OPENBOX_PORT_FALLBACK"
  printf '%s\n' "$_cp"
}
# ---- openbox-port-check:end ----

meta_field() {
  # meta.json 是打包脚本写的,一行一个字段;不依赖 jsonfilter(不是每个固件都有)
  sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$META" 2>/dev/null | head -n 1
}

# 服务控制脚本:OpenWrt 是 /etc/init.d/<名字>;Debian / Ubuntu 是随包铺的 systemctl 包装 debian/bin/<名字>-ctl,
# 动作集合一样(start / stop / restart / enable / disable / enabled / status)。都没有就打印空
svc_script() {
  if [ "${OPENBOX_PLATFORM:-}" = container ] && [ -x "$ROOT/docker/bin/$1-ctl" ]; then
    printf '%s\n' "$ROOT/docker/bin/$1-ctl"
  elif [ -x "/etc/init.d/$1" ]; then
    printf '%s\n' "/etc/init.d/$1"
  elif [ -x "$ROOT/debian/bin/$1-ctl" ]; then
    printf '%s\n' "$ROOT/debian/bin/$1-ctl"
  fi
}

# 路由器的 LAN 地址(给人看的面板地址用);取不到就留个占位
lan_ip() {
  _ip=""
  command -v uci >/dev/null 2>&1 && _ip=$(uci -q get network.lan.ipaddr 2>/dev/null | awk '{print $1}')
  _ip=${_ip%%/*}
  [ -n "$_ip" ] || _ip=$(ip -4 addr show br-lan 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -n 1)
  # Debian / Ubuntu 没有 br-lan:取默认路由出口那块网卡的地址
  [ -n "$_ip" ] || _ip=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.*src \([0-9.]*\).*/\1/p' | head -n 1)
  printf '%s\n' "${_ip:-<本机地址>}"
}

# 用随包的 Node 跑一个脚本(参数原样传过去),退出码就是脚本的退出码
run_node() {
  [ -x "$NODE" ] || { echo "找不到 Node 运行时:$NODE" >&2; return 1; }
  # 内核缺 madvise 的设备上 Node 要带兼容库(安装 / 升级脚本记在 data/node-preload,GitHub #290 #293;没有就是空)
  _preload=$(cat "$ROOT/data/node-preload" 2>/dev/null)
  # node/lib/ 里是给 OpenWrt 的 musl 版 libstdc++;Debian 装的是 glibc 版 Node,安装脚本会把 node/lib 删掉,
  # 那时就不能再设 LD_LIBRARY_PATH(glibc 的 Node 装上 musl 的 libstdc++ 直接崩)
  if [ -d "$ROOT/node/lib" ]; then
    LD_PRELOAD="$_preload" OPENSSL_CONF=/dev/null LD_LIBRARY_PATH="$ROOT/node/lib" "$NODE" --no-warnings "$@"
  else
    LD_PRELOAD="$_preload" OPENSSL_CONF=/dev/null "$NODE" --no-warnings "$@"
  fi
}

read_password() {
  run_node "$ROOT/panel/server/system/access-password-cli.mjs" "$DB"
}

fetch() {
  # $1 = URL;正文打到 stdout。curl 优先,没有就用 wget(OpenWrt 自带的是 uclient-fetch)
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --connect-timeout 8 --max-time 15 "$1" 2>/dev/null
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O - --timeout=15 "$1" 2>/dev/null
  else
    return 1
  fi
}

# 最新版本号:读 Release 里那份不带版本号的组件清单(一两 KB),直连不通就依次换内置镜像
latest_version() {
  _arch=$(meta_field arch)
  [ -n "$_arch" ] || _arch=x64
  _url="https://github.com/$REPO/releases/latest/download/open-box-linux-$_arch-components.json"
  for _prefix in "" $MIRRORS; do
    if [ -n "$_prefix" ]; then _u="$_prefix/$_url"; else _u="$_url"; fi
    _v=$(fetch "$_u" | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\(v[0-9][0-9A-Za-z._-]*\)".*/\1/p' | head -n 1)
    if [ -n "$_v" ]; then printf '%s\n' "$_v"; return 0; fi
  done
  return 1
}

# $1 比 $2 旧则成功(和 update.sh 的 version_less_than 同一个写法,不依赖 sort -V)
version_less_than() {
  awk -v a="${1#v}" -v b="${2#v}" 'BEGIN { na = split(a, aa, "."); nb = split(b, bb, "."); for (i = 1; i <= 3; i++) { av = (i <= na ? aa[i] + 0 : 0); bv = (i <= nb ? bb[i] + 0 : 0); if (av < bv) exit 0; if (av > bv) exit 1 } exit 1 }'
}

cmd_password() {
  _pw=$(read_password); _rc=$?
  if [ "$_rc" = 0 ]; then printf '%s\n' "$_pw"; return 0; fi
  return "$_rc"
}

cmd_check() {
  _cur=$(meta_field version)
  _new=$(latest_version) || _new=""
  _st=unknown
  if [ -n "$_cur" ] && [ -n "$_new" ]; then
    if version_less_than "$_cur" "$_new"; then _st=update; else _st=latest; fi
  fi
  printf 'current=%s\nlatest=%s\nstatus=%s\n' "$_cur" "$_new" "$_st"
}

cmd_update() {
  if [ "${OPENBOX_PLATFORM:-}" = container ]; then echo 'Docker 版请在宿主上执行 docker compose pull && docker compose up -d' >&2; return 1; fi
  [ -f "$ROOT/update.sh" ] || { echo "找不到升级脚本:$ROOT/update.sh" >&2; return 1; }
  sh "$ROOT/update.sh" "$@"
}

# 面板在跑没有。pgrep 优先:开发路由器(OpenWrt 25.12)上的 ps **只列有终端的进程**,
# `ps w | grep index.mjs` 一条都匹配不到 —— 第一版就是因此判成"没在跑",改完端口没重启面板,
# 新端口压根没生效。ps 那条只当没有 pgrep 时的兜底。
panel_running() {
  if command -v pgrep >/dev/null 2>&1; then
    pgrep -f "panel/server/index.mjs" >/dev/null 2>&1 && return 0
    return 1
  fi
  ps w 2>/dev/null | grep -q "[p]anel/server/index.mjs"
}

# open-box port            打印当前端口
# open-box port --check N  只查冲突,不改(安装脚本用)
# open-box port N          改端口
# 输出对机器友好:成功打 "port=N" 和 "restarted=yes|no",失败把原因打到 stderr 并非 0 退出 ——
# LuCI 的「修改端口」直接把 stderr 当错误提示显示给用户。
cmd_port() {
  if [ "${OPENBOX_PLATFORM:-}" = container ] && [ "$#" -gt 0 ]; then echo 'Docker 版请修改 Compose 的 OPENBOX_PANEL_PORT 并重建容器' >&2; return 1; fi
  case "${1:-}" in
    '')
      openbox_current_port
      return 0
      ;;
    --check)
      _reason=$(openbox_port_problem "${2:-}") && { echo "$_reason" >&2; return 1; }
      echo "ok"
      return 0
      ;;
  esac

  _new="$1"
  _cur=$(openbox_current_port)
  if [ "$_new" = "$_cur" ]; then
    printf 'port=%s\nrestarted=no\n' "$_cur"
    return 0
  fi
  _reason=$(openbox_port_problem "$_new") && { echo "$_reason" >&2; return 1; }

  mkdir -p "$(dirname "$OPENBOX_PORT_FILE")" 2>/dev/null
  _tmp="$OPENBOX_PORT_FILE.$$.tmp"
  printf '%s\n' "$_new" > "$_tmp" || { echo "写不了端口文件:$OPENBOX_PORT_FILE" >&2; return 1; }
  mv -f "$_tmp" "$OPENBOX_PORT_FILE" || { echo "写不了端口文件:$OPENBOX_PORT_FILE" >&2; return 1; }

  # 防火墙里那条面板放行规则跟着改(面板每次部署也会按自己实际监听的端口重写它,这里是为了立刻生效)
  if command -v uci >/dev/null 2>&1 && [ -n "$(uci -q get firewall.openbox_panel 2>/dev/null)" ]; then
    uci -q set firewall.openbox_panel.dest_port="$_new"
    if [ -n "$(uci -q changes firewall)" ]; then
      uci -q commit firewall
      /etc/init.d/firewall reload >/dev/null 2>&1 || true
    fi
  fi

  # 本来就在跑才重启:没在跑的机器不该被一次改端口顺手启动起来
  _panel_svc=$(svc_script openbox-panel)
  if panel_running && [ -n "$_panel_svc" ]; then
    "$_panel_svc" restart >/dev/null 2>&1 || true
    printf 'port=%s\nrestarted=yes\n' "$_new"
  else
    printf 'port=%s\nrestarted=no\n' "$_new"
  fi
  return 0
}

# 生成配置并启动内核:和面板里点「启动 / 重启」、升级脚本重拉内核同一条流水线(panel/server/cli/deploy.mjs:
# 冲突检测 → 规则集 → 校验 → 落盘 → DNS 接管 → 防火墙 → 启动 → 验证,auto_redirect 起不来时自动降级成纯 tun)。
# 以前「重新启动」和 LuCI 页面的启动按钮直接调 init 脚本:全新安装还没生成配置时什么都起不来、还提示「已发送」,
# auto_redirect 起不来的设备也不会降级、一直重复崩(GitHub #299 #290)
DEPLOY_STATUS=/tmp/openbox-deploy.status
DEPLOY_LOG=/tmp/openbox-deploy.log

# 跑一次部署;最后一行是 cli/deploy.mjs 打的结果 JSON({"ok":…,"message":…,"warning":…})
run_deploy() {
  ( export OPENBOX_ROOT="$ROOT" ZASHBOARD_DB_PATH="$DB"; run_node "$ROOT/panel/server/cli/deploy.mjs" )
}

# 从结果 JSON 里取一个字符串字段,只给人看(遇到转义的引号截断也无妨)
json_field() {
  printf '%s' "$1" | sed -n "s/.*\"$2\":\"\([^\"]*\)\".*/\1/p"
}

cmd_start() {
  case "${1:-}" in
    --detach) cmd_start_detach; return ;;
    --status) cat "$DEPLOY_STATUS" 2>/dev/null || echo none; return 0 ;;
  esac
  _out=$(run_deploy 2>&1)
  _rc=$?
  _res=$(printf '%s\n' "$_out" | tail -n 1)
  # 后台跑(--detach)时把结果写进状态文件,LuCI 页面靠它判断这次部署做完没有、成没成
  [ "${OPENBOX_DEPLOY_WORKER:-0}" = "1" ] && printf '%s\n' "$_res" > "$DEPLOY_STATUS"
  if [ "$_rc" = 0 ]; then
    printf '  openbox: 已生成配置并启动\n'
    _w=$(json_field "$_res" warning)
    [ -n "$_w" ] && printf '  %s\n' "$_w"
  else
    _m=$(json_field "$_res" message)
    printf '  openbox: 启动失败%s\n' "${_m:+:$_m}"
  fi
  return "$_rc"
}

# LuCI 页面用:rpcd 的 fs.exec 有超时,生成配置要十来秒(慢的机器加上降级更久),所以放到后台跑——先把状态写成
# running,跑完 worker 把结果写回去,页面用 `open-box start --status` 轮询。后台派发照抄 update.sh 的 --detach。
# setsid 也要套一层子壳 ( … & ):rpcd 的 exec 只要派发它的 shell 底下直接挂着后台子进程,就一直不回话(子进程
# 输出全重定向了、早跑完了也一样),LuCI 等到超时报「操作失败:XHR request timed out」,内核其实起来了(GitHub #469;
# 开发路由器 OpenWrt 25.12 上 ubus call file exec 实测:直接 & 等满 60 秒超时,套子壳 0 秒返回)
cmd_start_detach() {
  echo running > "$DEPLOY_STATUS"
  if command -v setsid >/dev/null 2>&1; then
    ( OPENBOX_DEPLOY_WORKER=1 setsid sh "$0" start > "$DEPLOY_LOG" 2>&1 < /dev/null & )
  elif command -v busybox >/dev/null 2>&1 && busybox setsid true >/dev/null 2>&1; then
    ( OPENBOX_DEPLOY_WORKER=1 busybox setsid sh "$0" start > "$DEPLOY_LOG" 2>&1 < /dev/null & )
  else
    # 连 nohup 都可能没有(#406 那种固件):有就套上,没有就靠 subshell 里忽略的信号直接起
    _ob_nohup=""
    if command -v nohup >/dev/null 2>&1; then _ob_nohup="nohup"; fi
    # shellcheck disable=SC2086
    ( trap '' HUP INT TERM; OPENBOX_DEPLOY_WORKER=1 $_ob_nohup sh "$0" start > "$DEPLOY_LOG" 2>&1 < /dev/null & ) > /dev/null 2>&1
  fi
  echo "已在后台生成配置并启动内核(open-box start --status 看结果)"
}

# 重启内核和面板。内核先起来(网络先通),再重启面板。任一服务不在就说一声,
# 不当成整体失败——只装了一半的机器上另一半照样该重启。
cmd_restart() {
  _rc=0
  if [ -n "$(svc_script openbox)" ]; then
    cmd_start || _rc=1
  else
    printf '  openbox: 没有这个服务(跳过)\n'
  fi
  _svc_path=$(svc_script openbox-panel)
  if [ -n "$_svc_path" ]; then
    if "$_svc_path" restart >/dev/null 2>&1; then
      printf '  openbox-panel: 已重启\n'
    else
      printf '  openbox-panel: 重启失败\n'
      _rc=1
    fi
  else
    printf '  openbox-panel: 没有这个服务(跳过)\n'
  fi
  return "$_rc"
}

# 卸载:直接把随包铺下来的 uninstall.sh 跑起来(同步、前台)。这里不用 --detach——
# 那是给 LuCI 页面用的(rpcd 的 XHR 会超时),SSH 下就该看着它跑完,而且脚本要问
# 「data/ 留不留」,得有终端。
cmd_uninstall() {
  if [ "${OPENBOX_PLATFORM:-}" = container ]; then echo 'Docker 版请在宿主上执行 docker compose down；挂载卷中的配置和数据将保留' >&2; return 1; fi
  [ -f "$ROOT/uninstall.sh" ] || { echo "找不到卸载脚本:$ROOT/uninstall.sh" >&2; return 1; }
  sh "$ROOT/uninstall.sh" "$@"
}

menu_password() {
  _pw=$(read_password 2>/dev/null); _rc=$?
  case "$_rc" in
    0) printf '\n  面板地址: http://%s:%s\n  当前密码: %s\n' "$(lan_ip)" "$(openbox_current_port)" "$_pw" ;;
    3) printf '\n  还没有设置密码:用浏览器打开 http://%s:%s,首次打开时设置。\n' "$(lan_ip)" "$(openbox_current_port)" ;;
    *) printf '\n  读不到密码(面板数据库不在,或 Node 运行时不可用)。\n' ;;
  esac
}

menu_check() {
  printf '\n  正在检查……\n'
  _out=$(cmd_check)
  _cur=$(printf '%s\n' "$_out" | sed -n 's/^current=//p')
  _new=$(printf '%s\n' "$_out" | sed -n 's/^latest=//p')
  _st=$(printf '%s\n' "$_out" | sed -n 's/^status=//p')
  printf '  当前版本: %s\n' "${_cur:-未知}"
  case "$_st" in
    latest) printf '  最新版本: %s\n  已经是最新版本。\n' "$_new" ;;
    update)
      printf '  最新版本: %s\n  有新版本。现在升级吗?升级过程中内核会重启一次。[y/N] ' "$_new"
      read -r _ans || _ans=""
      case "$_ans" in
        y|Y|yes|YES) printf '\n'; cmd_update ;;
        *) printf '  没有升级。以后可以再运行 open-box,或在面板 / LuCI 页面里升级。\n' ;;
      esac
      ;;
    *) printf '  查不到最新版本(访问不了 GitHub 和内置镜像)。稍后再试,或在面板里检查更新。\n' ;;
  esac
}

menu_restart() {
  printf '\n  正在重启内核和面板……\n'
  cmd_restart
  printf '  面板地址: http://%s:%s\n' "$(lan_ip)" "$(openbox_current_port)"
}

# 卸载在菜单里多问一句再动手:菜单是手滑按错数字的重灾区,而卸载不可撤销。
# 「data/ 留不留」交给 uninstall.sh 自己问,这里不重复。
menu_uninstall() {
  printf '\n  卸载会停掉服务、还原 DNS 与防火墙改动、删除程序文件(数据默认保留,下一步会问)。\n'
  printf '  确定卸载吗?[y/N] '
  read -r _ans || _ans=""
  case "$_ans" in
    y|Y|yes|YES)
      printf '\n'
      cmd_uninstall
      # 卸载完自己这个文件也没了,菜单不能再转回去
      exit 0
      ;;
    *) printf '  没有卸载。\n' ;;
  esac
}

menu() {
  while :; do
    printf '\nOpen-Box %s\n' "$(meta_field version)"
    printf '  1) 当前密码\n  2) 重新启动\n  3) 检查升级\n  4) 卸载\n  5) 退出\n'
    printf '请选择 [1-5]: '
    read -r _choice || { printf '\n'; return 0; }
    case "$_choice" in
      1) menu_password ;;
      2) menu_restart ;;
      3) menu_check ;;
      4) menu_uninstall ;;
      5|q|Q|exit|quit) return 0 ;;
      '') ;;
      *) printf '  请输入 1 到 5。\n' ;;
    esac
  done
}

case "${1:-}" in
  '') menu ;;
  password) cmd_password ;;
  restart) cmd_restart ;;
  start) shift; cmd_start "$@" ;;
  port) shift; cmd_port "$@" ;;
  check) cmd_check ;;
  update) shift; cmd_update "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  -h|--help|help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "未知命令:$1(open-box --help 看用法)" >&2; exit 2 ;;
esac
