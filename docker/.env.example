OPENBOX_IMAGE=open-box:0.1.328
OPENBOX_LAN_INTERFACE=eth0
OPENBOX_LAN_IP=192.168.1.2
OPENBOX_LAN_SUBNET=192.168.1.0/24
OPENBOX_LAN_GATEWAY=192.168.1.1
# 虚拟机不能使用多个 MAC 时可选 ipvlan（L2 默认模式）。
OPENBOX_NETWORK_DRIVER=macvlan
# New installations use 3036. Keep your previous value when upgrading.
OPENBOX_PANEL_PORT=3036
OPENBOX_MASQUERADE=1
# V8 老生代堆上限，不是整个容器的内存上限。默认 160 MiB。
OPENBOX_PANEL_HEAP_MB=160
# 留空时沿用 heap + 140 MiB 的面板 RSS 自检；显式设置需 >= 120 且 >= heap + 64。
OPENBOX_PANEL_RSS_LIMIT_MB=
TZ=Asia/Shanghai
